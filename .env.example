# Copie para .env (que fica fora do git). Só o que é do ambiente fica aqui:
# certificado e senha são de cada emitente, em emitentes/<nome>.toml.
NFSE_AMBIENTE=homologacao            # único valor aceito na PoC (produção restrita)
# SEFIN: host e basePath da especificação servida pela própria API (T-015, 2026-10-09)
NFSE_SEFIN_URL=https://sefin.producaorestrita.nfse.gov.br/SefinNacional
NFSE_ADN_URL=https://adn.producaorestrita.nfse.gov.br
# Pacote oficial de XSDs ativo (DPS_v1.01.xsd e dependências; schemas/LEIAME.md)
NFSE_XSD_DIR=schemas/v1.01-prodrest-20260727
