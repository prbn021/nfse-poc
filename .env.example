# Copie para .env (que fica fora do git)
NFSE_AMBIENTE=homologacao            # homologacao | producao
NFSE_CERT_PATH=certs/certificado.pfx
NFSE_CERT_PASSWORD=
# Confirme as URLs na documentação oficial (página de APIs prod. restrita e produção)
NFSE_SEFIN_URL=https://sefin.producaorestrita.nfse.gov.br
NFSE_ADN_URL=https://adn.producaorestrita.nfse.gov.br
# Pasta com os XSDs oficiais (DPS_v1.01.xsd e dependências)
NFSE_XSD_DIR=schemas/1.01
